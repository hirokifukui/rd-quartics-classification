/-- Cleared `aDen` identity: the pulled-back denominator is `-62208·adP6`
up to the chart clearing. -/
theorem aden_cleared (a r s : ℚ)
    (hr : 9*a^2 - 14*a + 9 = r^2) (hs : 9*a^2 - 6*a + 9 = s^2) :
    (7*(wNp a r s) - 18*(wDp r s)) * (zNp a r s) * (wDp r s)^2
      + ((wNp a r s)^3 + 4*(wNp a r s)^2*(wDp r s)
          - 252*(wNp a r s)*(wDp r s)^2) * (zDp a r s)
      = -62208 * adP6 a r s := by
  unfold zNp zDp wNp wDp K1p adP6
  linear_combination
