/-! ## 2. The inverse map (Magma GB, Sage-verified) -/

/-- Numerator of the inverse `w`-coordinate. -/
def wNp (a r s : ℚ) : ℚ := 18*(15*a - 6*r - s - 13)

/-- Denominator of the inverse `w`-coordinate. -/
def wDp (r s : ℚ) : ℚ := 3*r - 7*s + 12

/-- Reduced kernel factor of the `z`-solve (`= (a*(7w-18) - 9*(w+2))`
cleared by `wDp` and divided by 18). -/
def K1p (a r s : ℚ) : ℚ := 105*a^2 - 45*a*r - 238*a + 51*r + 16*s + 105

/-- Numerator of the inverse `z`-coordinate (structured form; equals the
30-term quartic of the certificate file after expansion). -/
def zNp (a r s : ℚ) : ℚ :=
  9*(2*wNp a r s - 12*wDp r s)*(wNp a r s + 2*wDp r s)*(wDp r s)
    - a*((wNp a r s)^3 + 4*(wNp a r s)^2*(wDp r s) - 252*(wNp a r s)*(wDp r s)^2)

/-- Denominator of the inverse `z`-coordinate. -/
def zDp (a r s : ℚ) : ℚ := 18 * K1p a r s * (wDp r s)^2

/-- The sign-selection sextic: the essential numerator factor of
`aDen(w,z)` pulled back along the inverse map (Sage stage 3, canonical
mod-ideal representative, unit `-62208`). -/
def adP6 (a r s : ℚ) : ℚ :=
  -15064695*a*r*s^4 + 9029055*a*s^5 - 2983275*r*s^5 + 4985475*s^6
    + 106313580*a*r*s^3 - 112603320*a*s^4 + 35756697*r*s^4 - 42229133*s^5
    - 143856972*a*r*s^2 + 415929600*a*s^3 - 121880772*r*s^3 + 95245548*s^4
    - 394608672*a*r*s - 21311424*a*s^2 - 48676140*r*s^2 + 103362048*s^3
    + 833400576*a*r - 2611061568*a*s + 934428960*r*s - 758843424*s^2
    + 3732293376*a - 1245777408*r + 1320338880*s - 1009822464

/-! ## 3. No rational square root of 96 -/

/-- `96 = 2^5·3` is not a rational square.  (Used to kill the `a = 5/3`
and `a = 3/5` branches of the `K1p` eliminant, where Gate 1 forces
`(3r)^2 = 96` resp. `(5r)^2 = 96`.) -/
theorem sq_ne_96 (x : ℚ) : x^2 ≠ 96 := by
  -- Roadmap (tactics repairable, statement frozen).  Candidate routes:
  -- (a) `Rat.sqrt`: from x^2 = 96 get `∃ q, q*q = 96`; `Rat.exists_mul_self`
  --     turns this into `Rat.sqrt 96 * Rat.sqrt 96 = 96`, refuted by `norm_num`
  --     / `decide` (Rat.sqrt 96 = 9).
  -- (b) irrationality: `irrational_sqrt_natCast_iff` (or `Nat.Prime` variants
  --     via 96 = 16*6) against rationality of |x|.
  -- (c) manual 2-adic descent on x.num^2 = 96 * x.den^2.
  intro h
  have hs : Rat.sqrt 96 * Rat.sqrt 96 = 96 :=
    (Rat.exists_mul_self 96).mp ⟨x, by rw [← h]; ring⟩
  rw [show (96:ℚ) = ((96:ℕ):ℚ) by norm_num, Rat.sqrt_natCast] at hs
  norm_num at hs

/-! ## 4. Nonvanishing of the chart denominators (all sign choices) -/

/-- `wDp ≠ 0` whenever the gates hold and `a ≠ 0`.  Eliminant certificate:
`a^2*(225a^2-210a+238) ∈ (wDp, gates)`, and `225a^2-210a+238 =
(15a-7)^2 + 189 > 0`. -/
theorem wD_ne (a r s : ℚ)
    (hr : 9*a^2 - 14*a + 9 = r^2) (hs : 9*a^2 - 6*a + 9 = s^2)
    (h0 : a ≠ 0) : wDp r s ≠ 0 := by
  intro hD
  have key : a^2 * (225*a^2 - 210*a + 238) = 0 := by
    -- certificate: wD_cof0 * hD ± wD_cofR * hr ± wD_cofS * hs
    -- (verbatim cofactors in /tmp/wp3_stage3_certs.txt; note the sign
    -- convention from the file header)
    unfold wDp at hD
    linear_combination
      (-15/8*a^2*r - 35/8*a^2*s + 15/2*a^2 + 7/8*a*r + 49/24*a*s - 7/8*r*s
        - 49/24*s^2 - 7/2*a - 21/8*r - 21/8*s + 21/2) * hD
      - (45/8*a^2 - 21/8*a + 21/8*s + 63/8) * hr
      - (-245/8*a^2 + 343/24*a - 343/24*s + 49/8) * hs
  have hpos : 225*a^2 - 210*a + 238 > 0 := by nlinarith [sq_nonneg (15*a - 7)]
  have : a^2 = 0 := by
    rcases mul_eq_zero.mp key with h | h
    · exact h
    · exact absurd h (ne_of_gt hpos)
  exact h0 (pow_eq_zero_iff (by norm_num) |>.mp this)

/-- `K1p ≠ 0` whenever the gates hold and `a ≠ 0`.  Eliminant certificate:
`(3a-5)(5a-3)a^2(225a^2-210a+238) ∈ (K1p, gates)`; the linear branches are
killed by `sq_ne_96`, the quartic branch by positivity. -/
theorem K1_ne (a r s : ℚ)
    (hr : 9*a^2 - 14*a + 9 = r^2) (hs : 9*a^2 - 6*a + 9 = s^2)
    (h0 : a ≠ 0) : K1p a r s ≠ 0 := by
  intro hK
  have key : (3*a - 5) * ((5*a - 3) * (a^2 * (225*a^2 - 210*a + 238))) = 0 := by
    -- certificate: K1_cof0 * hK ± K1_cofR * hr ± K1_cofS * hs
    unfold K1p at hK
    linear_combination
      (-75/32*a*r*s^2 - 175/288*r^2*s^2 - 315/32*a*r*s - 245/96*r^2*s
        + 805/288*a*s^2 + 35/16*r*s^2 - 5/6*s^3 - 207/32*a*r - 161/96*r^2
        + 89/6*a*s + 357/32*r*s - 217/96*s^2 + 343/12*a + 441/32*r - 3*s
        - 63/4) * hK
      - (-875/32*a*r*s^2 - 125/27*s^4 - 3675/32*a*r*s + 4375/96*a*s^2
        + 2975/96*r*s^2 - 175/18*s^3 - 2415/32*a*r + 280*a*s + 4165/32*r*s
        + 6325/288*s^2 + 1897/4*a + 2737/32*r - 595/6*s - 1647/4) * hr
      - (-375*a^4 - 125/3*a^2*s^2 + 125/27*r^2*s^2 + 950*a^3 + 175/9*r^2*s
        + 1750/27*a*s^2 - 1670/3*a^2 + 115/9*r^2 - 1925/18*a*s + 15/2*r*s
        - 85/3*s^2 - 1915/9*a - 14*r + 217/6*s + 228) * hs
  rcases mul_eq_zero.mp key with h53 | key2
  · -- a = 5/3, so Gate 1 forces (3r)^2 = 96
    have ha : a = 5/3 := by linarith
    subst ha
    have h96 : (3*r)^2 = 96 := by linear_combination (-9 : ℚ) * hr
    exact sq_ne_96 (3*r) h96
  rcases mul_eq_zero.mp key2 with h35 | key3
  · -- a = 3/5, so Gate 1 forces (5r)^2 = 96
    have ha : a = 3/5 := by linarith
    subst ha
    have h96 : (5*r)^2 = 96 := by linear_combination (-25 : ℚ) * hr
    exact sq_ne_96 (5*r) h96
  rcases mul_eq_zero.mp key3 with ha2 | hquad
  · exact h0 (pow_eq_zero_iff (by norm_num) |>.mp ha2)
  · have hpos : 225*a^2 - 210*a + 238 > 0 := by nlinarith [sq_nonneg (15*a - 7)]
    exact absurd hquad (ne_of_gt hpos)

