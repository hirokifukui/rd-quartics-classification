/-! ## 7. The core lemma -/

set_option maxHeartbeats 1600000 in
/-- **Forward core**: under the gates and the three chart conditions, the
inverse point lies on `E`, avoids the a-map denominator locus, and maps
back to `a`. -/
theorem forward_core (a r s : ℚ)
    (hr : 9*a^2 - 14*a + 9 = r^2) (hs : 9*a^2 - 6*a + 9 = s^2)
    (hwD : wDp r s ≠ 0) (hK : K1p a r s ≠ 0) (hAd : adP6 a r s ≠ 0) :
    OnE (wNp a r s / wDp r s) (zNp a r s / zDp a r s) ∧
      aDen (wNp a r s / wDp r s) (zNp a r s / zDp a r s) ≠ 0 ∧
      aMap (wNp a r s / wDp r s) (zNp a r s / zDp a r s) = a := by
  have hzD : zDp a r s ≠ 0 := by
    unfold zDp
    exact mul_ne_zero (mul_ne_zero (by norm_num) hK) (pow_ne_zero 2 hwD)
  -- (ii) first: aDen ≠ 0 from aden_cleared and hAd
  have hDen : aDen (wNp a r s / wDp r s) (zNp a r s / zDp a r s) ≠ 0 := by
    intro hzero
    have expand : aDen (wNp a r s / wDp r s) (zNp a r s / zDp a r s)
        * ((wDp r s)^3 * zDp a r s) = -62208 * adP6 a r s := by
      -- clear denominators (field_simp with hwD, hzD) and close with
      -- linear_combination <adjuster> * (aden_cleared a r s hr hs)
      unfold aDen
      field_simp
      linear_combination (aden_cleared a r s hr hs)
    rw [hzero, zero_mul] at expand
    have : adP6 a r s = 0 := by linarith
    exact hAd this
  refine ⟨?_, hDen, ?_⟩
  · -- (i) OnE via curve_cleared: same div_eq_div_iff + linear_combination
    -- pattern as gate1_sq in Thm7RepairGates
    show (zNp a r s / zDp a r s)^2
        = (wNp a r s / wDp r s)^3 + 12*(wNp a r s / wDp r s)^2
          - 108*(wNp a r s / wDp r s)
    rw [show zDp a r s = 18 * K1p a r s * (wDp r s)^2 from rfl]
    field_simp
    linear_combination (curve_cleared a r s hr hs)
  · -- (iii) aMap = a: PURE ring identity after clearing (zero cofactors;
    -- z was defined as the exact solution of a·aDen = aNum)
    unfold aMap aNum
    rw [div_eq_iff hDen]
    unfold aDen
    field_simp
    unfold zNp zDp wNp wDp K1p
    ring

/-! ## 8. Fidelity anchor (pipeline value at a = 90/77, combo (+,+)) -/

/-- The inverse map at `(a,r,s) = (90/77, 171/77, 291/77)` gives the point
`(726/25, 22176/125)` of `E(ℚ)`, and the a-map returns `90/77` [MC]. -/
theorem anchor_90_77 :
    wNp (90/77) (171/77) (291/77) / wDp (171/77) (291/77) = 726/25 ∧
      zNp (90/77) (171/77) (291/77) / zDp (90/77) (171/77) (291/77)
        = 22176/125 ∧
      aMap (726/25) (22176/125) = 90/77 := by
  refine ⟨?_, ?_, ?_⟩ <;> norm_num [wNp, wDp, K1p, zNp, zDp, aMap, aNum, aDen]

/-! ## 9. The forward direction, proved -/

/-- **Theorem 7', ⇒ direction: proved** ([P] target; NO rank input --
the disclosed axiom `rank_E576i2` is not consumed anywhere in this file). -/
theorem thm7_forward : Thm7Forward := by
  rintro a ⟨h0, _h1, ⟨r, hr⟩, ⟨s, hs⟩⟩
  have hrn : 9*a^2 - 14*a + 9 = (-r)^2 := by rw [neg_sq]; exact hr
  have hsn : 9*a^2 - 6*a + 9 = (-s)^2 := by rw [neg_sq]; exact hs
  rcases adP6_cover a r s hr hs with h | h | h | h
  · exact ⟨_, _, forward_core a r s hr hs
      (wD_ne a r s hr hs h0) (K1_ne a r s hr hs h0) h⟩
  · exact ⟨_, _, forward_core a (-r) s hrn hs
      (wD_ne a (-r) s hrn hs h0) (K1_ne a (-r) s hrn hs h0) h⟩
  · exact ⟨_, _, forward_core a r (-s) hr hsn
      (wD_ne a r (-s) hr hsn h0) (K1_ne a r (-s) hr hsn h0) h⟩
  · exact ⟨_, _, forward_core a (-r) (-s) hrn hsn
      (wD_ne a (-r) (-s) hrn hsn h0) (K1_ne a (-r) (-s) hrn hsn h0) h⟩


/-- **Theorem 7' -- UNCONDITIONAL.**  The repaired BM2000 Theorem 7 holds
with the standard three axioms only: the backward direction is the gate
identity machinery (rank input zero), the forward direction is the explicit
Groebner inverse of the a-map (rank input zero).  The disclosed axiom
`rank_E576i2` is NOT consumed here; it remains available solely for the
BK-style enumeration of `E(ℚ)` (not needed for the classification
statement itself). -/
theorem thm7prime : Thm7Prime := ⟨thm7_backward, thm7_forward⟩

